# Copy to .env and adjust. Never commit the resulting .env file.
# Values shown are the built-in defaults from app/core/config.py.

# --- Application -------------------------------------------------------------
APP_NAME=async-ai-document-pipeline
ENVIRONMENT=local              # local | test | production
DEBUG=false

# --- HTTP --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:8000

# --- PostgreSQL --------------------------------------------------------------
# Use host "postgres" when running under docker compose, "localhost" otherwise.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docpipeline
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false
DB_CONNECT_MAX_ATTEMPTS=30
DB_CONNECT_RETRY_SECONDS=2.0

# Consumed by the postgres container in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docpipeline

# --- Redis -------------------------------------------------------------------
# Use host "redis" when running under docker compose, "localhost" otherwise.
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_NAME=document-processing
REDIS_CONSUMER_GROUP=document-workers
REDIS_BLOCK_MS=5000
REDIS_READ_COUNT=1
REDIS_CONNECT_MAX_ATTEMPTS=30
REDIS_CONNECT_RETRY_SECONDS=2.0

# --- Worker reliability ------------------------------------------------------
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_JITTER_RATIO=0.2
PENDING_MIN_IDLE_MS=60000
PENDING_SWEEP_INTERVAL_SECONDS=30.0
RETRY_SWEEP_INTERVAL_SECONDS=1.0
MAX_DELIVERY_COUNT=5
STALE_PROCESSING_SECONDS=600

# --- File handling -----------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=uploads
MAX_UPLOAD_BYTES=10485760      # 10 MB
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt,.docx

# --- LLM ---------------------------------------------------------------------
# Set LLM_PROVIDER=fake to run the whole pipeline with no API key and no cost.
LLM_PROVIDER=openai            # openai | fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_ATTEMPTS=1
LLM_TEMPERATURE=0.0
LLM_MAX_INPUT_CHARS=40000
CLASSIFICATION_MAX_CHARS=2000
RAW_TEXT_STORE_MAX_CHARS=20000

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true                  # set false for readable local output

# --- Dashboard ---------------------------------------------------------------
DASHBOARD_POLL_INTERVAL_MS=3000
DASHBOARD_RECENT_JOBS_LIMIT=25
